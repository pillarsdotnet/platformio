export PYBUILD_NAME=platformio

# The sdist's only test module, tests/test_examples.py, clones example
# projects and downloads toolchains from the network, which no builder has.
# debian/tests/control smoke-tests the installed package instead.
export PYBUILD_DISABLE=test

%:
	dh $@ --buildsystem=pybuild
