# Only debian/ and .forgejo/ are ours. The upstream source is fetched from
# PyPI at build time and never lives here, so a working copy of it, the orig
# tarball and every build artifact are all ignored.
/*
!/.forgejo/
!/debian/
!/README.md
!/trivy.yaml
!/.gitignore

# Build artifacts inside debian/.
/debian/.debhelper/
/debian/debhelper-build-stamp
/debian/files
/debian/platformio/
/debian/platformio.substvars
/debian/patches/.pc/
/debian/.pc/
# The lint configuration, which must be tracked for the Lint workflow to
# find it: this file whitelists, so anything not named here is invisible
# to `git add -A` and the workflow then fails with ".pre-commit-config.yaml
# is not a file" having committed nothing.
!/.pre-commit-config.yaml
!/.vale.ini
!/.vale/
!/.markdownlint.yaml
!/.yamllint
