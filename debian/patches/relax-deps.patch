     core = [
         "pip",
-        "bottle == 0.13.*",
+        "bottle >= 0.12",
         "click >=8.0.4, <8.6, !=8.3",  # click 9.0 removes 'protected_args' attribute
         "colorama",
         "marshmallow >=3, <5",
